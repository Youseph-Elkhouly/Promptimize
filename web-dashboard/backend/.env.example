# Promptimize Backend Environment Variables

# Google Gemini (required for optimization)
GEMINI_API_KEY=

# Backboard.io Memory (optional — falls back to local stub)
BACKBOARD_API_KEY=
BACKBOARD_PROJECT_ID=
BACKBOARD_BASE_URL=https://api.backboard.io

# MongoDB Atlas (required for persistence — falls back to in-memory if missing)
MONGODB_URI=
MONGODB_DB_NAME=promptimize

# Server
CORS_ORIGINS=http://localhost:3000
PORT=8000

# Cost defaults
DEFAULT_MONTHLY_CALLS=10000
DEFAULT_OUTPUT_TOKEN_ESTIMATE=700
