# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cost Defaults
PROMPTIMIZE_DEFAULT_MONTHLY_CALLS=10000
PROMPTIMIZE_COST_BUDGET_MONTHLY=100
PROMPTIMIZE_MAX_COST_INCREASE_PERCENT=20
