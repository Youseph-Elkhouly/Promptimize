{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Promptimize Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions",
        "${workspaceFolder}/../examples/sample-ai-app"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: compile",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "trace": false
    }
  ]
}
